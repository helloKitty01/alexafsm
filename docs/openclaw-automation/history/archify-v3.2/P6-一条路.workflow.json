{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "一条路:tick → [trigger] → run,两道门都是可选旁路",
    "locale": "zh-CN",
    "animation": "trace",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "wake",
        "label": "① 叫醒",
        "focus": [
          "filter",
          "tick"
        ],
        "note": "filter 在事件中心侧答\"值不值得叫醒我\";过了才变成 tick,与时间到点、self 闹钟同一入口。"
      },
      {
        "id": "judge",
        "label": "② 判定(可选)",
        "focus": [
          "tick",
          "trigger",
          "state"
        ],
        "note": "L2 起才有 trigger:script 默认零 token,agent 可选;fire:false 只写 state,不产生 run。"
      },
      {
        "id": "run",
        "label": "③ 执行",
        "focus": [
          "trigger",
          "run",
          "quota",
          "deliver"
        ],
        "note": "fire 就跑一次 payload:动作确定 → script 直接调工具;要生成 / 交互 / 确认 → agentTurn。配额到顶 → 暂停 + 告警。"
      }
    ]
  },
  "lanes": [
    {
      "id": "hub",
      "label": "事件中心"
    },
    {
      "id": "cron",
      "label": "cron service"
    },
    {
      "id": "checker",
      "label": "checker · 脚本沙箱 / 只读模型"
    },
    {
      "id": "exec",
      "label": "执行"
    }
  ],
  "phases": [
    {
      "id": "p-wake",
      "label": "叫醒",
      "fromCol": 0,
      "toCol": 1
    },
    {
      "id": "p-judge",
      "label": "判定 · 可选",
      "fromCol": 2,
      "toCol": 3,
      "variant": "dashed"
    },
    {
      "id": "p-run",
      "label": "执行",
      "fromCol": 4,
      "toCol": 5,
      "variant": "emphasis"
    }
  ],
  "groups": [],
  "mainPath": [
    "tick",
    "trigger",
    "run",
    "deliver"
  ],
  "nodes": [
