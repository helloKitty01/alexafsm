    {
      "id": "e-run-deliver",
      "from": "run",
      "to": "deliver",
      "variant": "emphasis"
    }
  ],
  "cards": [
    {
      "dot": "violet",
      "title": "两道门都可选",
      "items": [
        "L0 / L1:tick → run",
        "L2 / L3:多一个 trigger"
      ]
    },
    {
      "dot": "rose",
      "title": "配额不在路上",
      "items": [
        "cron service 的计数器,run / check 时 +1;有系统默认值"
      ]
    }
  ]
